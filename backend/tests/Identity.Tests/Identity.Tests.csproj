<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Nestly.Identity.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!--
      Pinned to the 7.x line deliberately: FluentAssertions 8.0 moved to a
      paid licence for commercial use, and Nestly is a commercial product.
      7.2.0 is the last Apache-2.0 release.
    -->
    <PackageReference Include="FluentAssertions" Version="7.2.2" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <!--
      SQLite rather than the EF in-memory provider: these tests assert on
      unique-index enforcement (task 35c), and the in-memory provider ignores
      indexes entirely, so it would report a false pass.
    -->
    <!-- Task #393: bumped past GHSA-2m69-gcr7-jv3q (High) in the transitive SQLitePCLRaw.lib.e_sqlite3 - test-only, never in a published image, but easy to clear so it should not linger. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.30" />
    <PackageReference Include="EFCore.NamingConventions" Version="8.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Application\Application.csproj" />
    <ProjectReference Include="..\..\shared\BuildingBlocks\BuildingBlocks.csproj" />
    <ProjectReference Include="..\..\shared\Domain\Domain.csproj" />
    <ProjectReference Include="..\..\shared\Infrastructure\Infrastructure.csproj" />
  </ItemGroup>

</Project>
