{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Cache": {
    "InstanceName": "nestly:",
    "DefaultExpiration": "00:05:00"
  },
  "RateLimiting": {
    "Otp": { "PermitLimit": 5, "WindowMinutes": 60 },
    "Login": { "PermitLimit": 10, "WindowMinutes": 15 },
    "Search": { "PermitLimit": 60, "WindowMinutes": 1 },
    "Payment": { "PermitLimit": 20, "WindowMinutes": 15 },
    "PaymentWebhook": { "PermitLimit": 120, "WindowMinutes": 1 }
  },
  "BackgroundJobs": {
    "ServerEnabled": false,
    "DashboardEnabled": false,
    "RetryAttempts": 5
  },
  "BusinessTime": {
    "TimeZoneId": "Asia/Kolkata"
  },
  "Booking": {
    "MaxQuantityPerBooking": 10
  },
  "Commission": {
    "DefaultRatePercentage": 15,
    "CategoryRateOverrides": {}
  },
  "AutoAssignment": {
    "Enabled": true,
    "RetryAttempts": 3,
    "RouteRankingEnabled": true,
    "MaxRouteCandidates": 10,
    "RouteRankingRadiusKm": 25,
    "TravelBufferEnabled": true,
    "TravelHandoverBufferMinutes": 15,
    "MaxTravelRouteLookups": 20,
    "ResponseWindowMinutes": 30
  },
  "CancellationPolicy": {
    "FreeCancellationWindowHours": 4,
    "LateCancellationFeePercentage": 20
  },
  "ReschedulePolicy": {
    "MinHoursBeforeSlot": 2,
    "MaxReschedulesPerBooking": 2,
    "LateFeeThresholdHours": 6,
    "LateRescheduleFeePercentage": 10
  },
  "ReviewPolicy": {
    "EnforceSubmissionWindow": true,
    "SubmissionWindowDays": 30
  },
  "Metrics": {
    "FailureRateWindowMinutes": 5,
    "MinimumSamplesForAlert": 10,
    "PaymentFailureRateThreshold": 0.2,
    "BookingFailureRateThreshold": 0.2,
    "NotificationFailureRateThreshold": 0.2
  },
  "GoogleMaps": {
    "Enabled": true,
    "TimeoutSeconds": 5,
    "CacheTtlSeconds": 60,
    "MaxDestinationsPerCall": 25,
    "MaxDestinationsPerEstimate": 100
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "FromAddress": "Nestly.test123@gmail.com",
    "FromName": "Glavyx"
  },
  "RouteEstimates": {
    "Sandbox": {
      "RoadWindingFactor": 1.3,
      "AverageSpeedKph": 25
    }
  },
  "AllowedHosts": "*"
}
