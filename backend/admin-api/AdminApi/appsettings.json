{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Cache": {
    "InstanceName": "nestly:",
    "DefaultExpiration": "00:05:00"
  },
  "RateLimiting": {
    "Login": { "PermitLimit": 5, "WindowMinutes": 15 }
  },
  "AdminIdentity": {
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 30
  },
  "BackgroundJobs": {
    "ServerEnabled": true,
    "DashboardEnabled": true,
    "DashboardPath": "/hangfire",
    "RetryAttempts": 5
  },
  "BusinessTime": {
    "TimeZoneId": "Asia/Kolkata"
  },
  "Booking": {
    "MaxQuantityPerBooking": 10
  },
  "Commission": {
    "DefaultRatePercentage": 15,
    "CategoryRateOverrides": {}
  },
  "Metrics": {
    "FailureRateWindowMinutes": 5,
    "MinimumSamplesForAlert": 10,
    "PaymentFailureRateThreshold": 0.2,
    "BookingFailureRateThreshold": 0.2,
    "NotificationFailureRateThreshold": 0.2
  },
  "GoogleMaps": {
    "Enabled": true,
    "TimeoutSeconds": 5,
    "CacheTtlSeconds": 60,
    "MaxDestinationsPerCall": 25,
    "MaxDestinationsPerEstimate": 100
  },
  "SupabaseStorage": {
    "Enabled": true,
    "BucketName": "uploads",
    "TimeoutSeconds": 15
  },
  "RouteEstimates": {
    "Sandbox": {
      "RoadWindingFactor": 1.3,
      "AverageSpeedKph": 25
    }
  },
  "AllowedHosts": "*"
}
