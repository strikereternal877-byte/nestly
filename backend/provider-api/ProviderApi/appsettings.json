{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Cache": {
    "InstanceName": "nestly:",
    "DefaultExpiration": "00:05:00"
  },
  "RateLimiting": {
    "Otp": { "PermitLimit": 5, "WindowMinutes": 60 },
    "Login": { "PermitLimit": 10, "WindowMinutes": 15 }
  },
  "ProviderAccount": {
    "MaxFailedLoginAttempts": 5,
    "LockoutWindowMinutes": 15
  },
  "BackgroundJobs": {
    "ServerEnabled": false,
    "DashboardEnabled": false,
    "RetryAttempts": 5
  },
  "Metrics": {
    "FailureRateWindowMinutes": 5,
    "MinimumSamplesForAlert": 10,
    "PaymentFailureRateThreshold": 0.2,
    "BookingFailureRateThreshold": 0.2,
    "NotificationFailureRateThreshold": 0.2
  },
  "AllowedHosts": "*"
}
